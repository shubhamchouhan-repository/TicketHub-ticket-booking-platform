# Copy to .env (never commit .env). Placeholders only - generate your own values.
POSTGRES_USER=tickethub
POSTGRES_PASSWORD=root

# Gateway JWT signing secret: at least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters


# Shared secret used to sign/verify payment provider webhooks (HMAC-SHA256)
# PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_WEBHOOK_SECRET=TicketHub_Mock_Webhook_2026_SecureKey9x

# Development token endpoint (POST /auth/token). Keep false outside local/integration use.
DEV_TOKEN_ENABLED=true
# DEV_ADMIN_KEY=change-me-admin-key


# Image tag used by docker compose (release/rollback exercise)
TICKETHUB_TAG=latest

# ---- Profiles (what Spring/Docker should turn on) --------------------------------------------
# docker            = default
# docker,elk        = also ship JSON logs to Logstash (start with: docker compose --profile elk up -d)
# docker,stripe     = use the Stripe TEST sandbox instead of the simulated provider
# docker,elk,stripe = both
TICKETHUB_PROFILES=docker
# JSON  = one JSON object per log line (default, structured logs)
# CONSOLE = readable text logs inside Docker
TICKETHUB_LOG_APPENDER=JSON

# ---- Keycloak (docker compose --profile iam up -d) -------------------------------------------
# Set KEYCLOAK_ENABLED=true so the gateway also accepts Keycloak tokens (dev tokens keep working).
KEYCLOAK_ENABLED=false
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin12345

# ---- Object storage for event posters (MinIO locally, AWS S3 in the cloud) --------------------
MEDIA_S3_ACCESS_KEY=tickethub-minio
MEDIA_S3_SECRET_KEY=tickethub-minio-secret

# ---- Grafana ---------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Stripe sandbox (only with TICKETHUB_PROFILES containing "stripe"). TEST keys only! ------
# STRIPE_SECRET_KEY=sk_test_xxx

# Where each secret is used:
#   DEV_ADMIN_KEY          authorizes the development token endpoint
#   JWT_SECRET             signs and verifies the gateway's development JWTs
#   PAYMENT_WEBHOOK_SECRET verifies payment webhook signatures

# ST-76: shared secret for service-to-service calls to /internal/**. Leave empty to keep the old behaviour (network isolation only).
# To turn on, set any long random value (e.g. `openssl rand -hex 24`) and run: docker compose up -d --force-recreate event-service booking-service payment-service
INTERNAL_API_KEY=
